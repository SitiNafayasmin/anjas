{
  "name": "9router-saas",
  "private": true,
  "version": "0.1.0",
  "description": "SaaS starter for selling coding API keys backed by 9router.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @9router-saas/web",
    "dev:web": "npm run dev --workspace @9router-saas/web",
    "dev:api": "npm run dev --workspace @9router-saas/api",
    "dev:proxy": "npm run dev --workspace @9router-saas/proxy",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "db:generate": "npm run db:generate --workspace @9router-saas/db",
    "db:migrate": "npm run db:migrate --workspace @9router-saas/db",
    "db:migrate:deploy": "npm run db:migrate:deploy --workspace @9router-saas/db",
    "db:seed": "npm run db:seed --workspace @9router-saas/db",
    "infra:up": "docker compose up -d postgres redis 9router",
    "infra:down": "docker compose down"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "fastify": "^5.8.5",
    "postcss": "^8.5.10"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.1",
    "eslint": "^9.25.1",
    "prettier": "^3.5.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.31.1"
  }
}
