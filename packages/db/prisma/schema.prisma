generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  SUSPENDED
  CANCELED
}

enum ApiKeyStatus {
  ACTIVE
  REVOKED
}

enum UsageStatus {
  SUCCESS
  ERROR
  RATE_LIMITED
  QUOTA_EXCEEDED
}

enum PaymentStatus {
  PENDING
  PAID
  EXPIRED
  FAILED
}

model User {
  id            String               @id @default(cuid())
  email         String               @unique
  name          String?
  passwordHash  String?
  role          UserRole             @default(USER)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  sessions      Session[]
  apiKeys       ApiKey[]
  subscriptions Subscription[]
  usageEvents   UsageEvent[]
  requestLogs   RequestLog[]
  payments      PaymentTransaction[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model Plan {
  id                   String               @id @default(cuid())
  slug                 String               @unique
  name                 String
  monthlyPriceIdr      Int                  @default(0)
  monthlyTokenQuota    BigInt
  dailyRequestLimit    Int
  requestsPerMinute    Int
  maxConcurrentStreams Int
  allowedModelAliases  String[]
  isActive             Boolean              @default(true)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  subscriptions        Subscription[]
  payments             PaymentTransaction[]
}

model Subscription {
  id           String             @id @default(cuid())
  userId       String
  planId       String
  status       SubscriptionStatus @default(TRIAL)
  currentStart DateTime           @default(now())
  currentEnd   DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan         Plan               @relation(fields: [planId], references: [id])

  @@index([userId, status])
}

model ApiKey {
  id          String       @id @default(cuid())
  userId      String
  name        String
  prefix      String       @unique
  keyHash     String       @unique
  status      ApiKeyStatus @default(ACTIVE)
  lastUsedAt  DateTime?
  createdAt   DateTime     @default(now())
  revokedAt   DateTime?
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  usageEvents UsageEvent[]
  requestLogs RequestLog[]

  @@index([userId, status])
}

model ModelAlias {
  id              String   @id @default(cuid())
  alias           String   @unique
  description     String
  fallbackModels  String[]
  isPublic        Boolean  @default(true)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model UsageEvent {
  id             String      @id @default(cuid())
  userId         String
  apiKeyId       String
  modelAlias     String
  resolvedModel  String?
  provider       String?
  inputTokens    Int         @default(0)
  outputTokens   Int         @default(0)
  status         UsageStatus
  latencyMs      Int?
  estimatedCost  Decimal?    @db.Decimal(12, 6)
  requestId      String?
  createdAt      DateTime    @default(now())
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  apiKey         ApiKey      @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([apiKeyId, createdAt])
  @@index([requestId])
}

model RequestLog {
  id            String      @id @default(cuid())
  userId        String?
  apiKeyId      String?
  method        String
  path          String
  modelAlias    String?
  resolvedModel String?
  provider      String?
  status        UsageStatus
  statusCode    Int
  errorCode     String?
  latencyMs     Int?
  requestId     String      @unique
  createdAt     DateTime    @default(now())
  user          User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  apiKey        ApiKey?     @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([apiKeyId, createdAt])
}

model PaymentTransaction {
  id                    String        @id @default(cuid())
  userId                String
  planId                String
  provider              String        @default("qris")
  providerTransactionId String?
  orderId               String        @unique
  amountOriginal        Int
  amountUnique          Int           @default(0)
  amountTotal           Int
  qrisContent           String?
  status                PaymentStatus @default(PENDING)
  rawProviderResponse   Json?
  paidAt                DateTime?
  expiresAt             DateTime?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  user                  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan                  Plan          @relation(fields: [planId], references: [id])

  @@index([userId, createdAt])
  @@index([providerTransactionId])
  @@index([status, expiresAt])
}
